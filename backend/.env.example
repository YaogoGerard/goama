# Copier en .env pour le développement local (le .env n'est jamais commité).
# En production : Docker secrets (REQ-OPS-002).

PORT=8080
DATABASE_URL=postgresql://goama:goama@localhost:5432/goama

# Clé de signature des JWT : 64 caractères aléatoires en production
JWT_SECRET=changez-moi-en-production

# Dossier local des blobs chiffrés (remplace MinIO au sprint — doc 06 §2, repli assumé)
FILES_DIR=./data/files

# Limitation de débit (doc 06 §7)
LOGIN_RATE_MAX=5
GLOBAL_RATE_MAX=300

# Origine autorisée pour le client Vue (true = reflète l'origine, pour le dev)
CORS_ORIGIN=true
