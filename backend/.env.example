# Copier en .env pour le développement local (le .env n'est jamais commité).
# En production : Docker secrets (REQ-OPS-002).

PORT=8080
DATABASE_URL=postgresql://goama:REMPLACER_PAR_UN_SECRET@localhost:5432/goama

# Clé de signature des JWT : 64 caractères aléatoires en production
JWT_SECRET=REMPLACER_PAR_64_CARACTERES_ALEATOIRES
# Clé indépendante AES-256-GCM (64 caractères hex) pour les secrets TOTP
TOTP_ENCRYPTION_KEY=REMPLACER_PAR_64_CARACTERES_HEXADECIMAUX

# Dossier local des blobs chiffrés (remplace MinIO au sprint — doc 06 §2, repli assumé)
FILES_DIR=./data/files

# Limitation de débit (doc 06 §7)
LOGIN_RATE_MAX=5
GLOBAL_RATE_MAX=300

# Origine autorisée pour le client Vue (true = reflète l'origine, pour le dev)
CORS_ORIGIN=true

# Environnement d'exécution
NODE_ENV=development

# Durée des codes d'activation et délai d'authentification WebSocket
ACTIVATION_TTL_H=24
WS_AUTH_TIMEOUT_MS=5000

# Compte administrateur créé au premier démarrage si aucun admin n'existe
ADMIN_MATRICULE=ADMIN001
# Production uniquement : injecter le secret Base32 via un gestionnaire de secrets
# ADMIN_TOTP_SECRET=
ADMIN_PASSWORD=changez-moi

# Démo locale uniquement : désactivé par défaut
DEMO_AUTH_BYPASS_TOTP=false
DEMO_ADMIN_MATRICULE=ADMIN001

# URLs affichées au démarrage de l'API
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_ADMIN_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8080
