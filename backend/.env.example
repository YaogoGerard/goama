# Développement local uniquement. Ne jamais réutiliser ces valeurs en production.
NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://goama:goama@localhost:5432/goama
JWT_SECRET=secret-de-dev-changez-moi
TOTP_ENCRYPTION_KEY=
GROUP_REQUEST_ENCRYPTION_KEY=
FILES_DIR=./data/files
LOGIN_RATE_MAX=5
GLOBAL_RATE_MAX=300
TRUST_PROXY=
CORS_ORIGIN=true
ACTIVATION_TTL_H=24
WS_AUTH_TIMEOUT_MS=5000
MEDIA_MAX_BYTES_PER_GROUP=1073741824
MEDIA_MAX_BYTES_PER_AGENT=268435456
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_ADMIN_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8080

# Optionnel en local : si renseignées, les trois valeurs sont obligatoires.
# Le TOTP n'est jamais affiché par le script d'amorçage.
# ADMIN_MATRICULE=ADMIN001
# ADMIN_PASSWORD=un-secret-local-de-14-caracteres
# ADMIN_TOTP_SECRET=BASE32_SECRET fourni par un gestionnaire local
