// Build de production : compile src/ vers dist/ (l'amorçage des comptes est
// compilé ; les scripts d'exploitation shells vivent dans scripts/).
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true
  },
  "include": ["src"]
}
